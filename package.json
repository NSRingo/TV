{
	"name": "@nsringo/tv",
	"organizationName": " iRingo",
	"displayName": " iRingo: 📺 TV app",
	"description": "全面自定义「TV app」功能",
	"homepage": "https://NSRingo.github.io/guide/apple-tv",
	"openUrl": "http://boxjs.com/#/app/iRingo.TV",
	"icon": "https://developer.apple.com/assets/elements/icons/apple-tv/apple-tv-128x128.png",
	"keywords": [],
	"contributors": [
		"VirgilClyne[https://github.com/VirgilClyne]"
	],
	"system": [
		"iOS",
		"iPadOS",
		"tvOS",
		"macOS"
	],
	"author": "VirgilClyne",
	"license": "Apache-2.0",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/NSRingo/TV.git"
	},
	"directories": {
		"example": "example"
	},
	"scripts": {
		"dev": "npm-run-all --parallel build:dev build:dev-args",
		"dev:pages": "wrangler pages dev --port 8787",
		"dev:workers": "wrangler dev -c wrangler.workers.jsonc",
		"dev:vercel": "npx vercel dev --listen 8787",
		"deploy:pages": "wrangler pages deploy",
		"deploy:workers": "wrangler deploy --minify -c wrangler.workers.jsonc",
		"deploy:vercel": "npx vercel deploy --prod",
		"build": "rollup -c",
		"build:dev": "rollup -c rollup.dev.config.mjs",
		"build:dev-args": "arguments-builder build -c arguments-builder.dev.config.ts",
		"build:release-args": "arguments-builder build -c arguments-builder.release.config.ts",
		"build:full-args": "arguments-builder boxjs -c arguments-builder.full.config.ts",
		"build:args:rewrite": "arguments-builder build -c arguments-builder.rewrite.config.ts",
		"build:args": "npm-run-all --serial build:release-args build:full-args build:args:rewrite",
		"dts": "arguments-builder dts -c arguments-builder.full.config.ts",
		"test": "node --test tests/*.test.mjs",
		"verify:artifacts": "node scripts/verify-artifacts.mjs"
	},
	"browserslist": [
		"iOS >= 15"
	],
	"devDependencies": {
		"@biomejs/biome": "2.4.6",
		"@iringo/arguments-builder": "^1.8.5",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-terser": "^1.0.0",
		"npm-run-all": "^4.1.5",
		"rollup": "^4.62.2",
		"typescript": "^6.0.3",
		"wrangler": "4.71.0"
	},
	"dependencies": {
		"@nsnanocat/util": "^2.7.5",
		"hono": "^4.12.31"
	},
	"systemVersion": 15,
	"overrides": {
		"@iringo/surge2egern": {
			"puppeteer": "25.7.0"
		}
	}
}
