name: "{{@package 'displayName'}}"
desc: |-
  {{#each (split (@package 'description') "\n")}}
  {{{this}}}
  {{/each}}
openUrl: "{{@package 'openUrl'}}"
author: |-
  {{#each (@package 'contributors')}}
  {{{this}}}
  {{/each}}
homepage: "{{@package 'homepage'}}"
icon: "{{@package 'icon'}}"
category: "{{@package 'organizationName'}}"
date: "{{now "yyyy-MM-dd HH:mm:ss"}}"
version: "{{@package 'version'}}"

rules:
  - DOMAIN,known-issues.apple.com,REJECT-DROP

http:
  mitm:
    - "uts-api.itunes.apple.com"
    - "umc-tempo-api.apple.com"
    - "play-cdn.itunes.apple.com"
    - "play-edge-cdn.itunes.apple.com"
  url-rewrite:
    - ^https?:\/\/play-cdn\.itunes\.apple\.com https://play.itunes.apple.com header
    - ^https?:\/\/play-edge-cdn\.itunes\.apple\.com https://play-edge.itunes.apple.com header
  script:
    - match: https?:\/\/uts-api\.itunes\.apple\.com\/uts\/(v1|v2|v3)\/
      name: TV.request
      type: request
      require-body: true
    - match: https?:\/\/uts-api\.itunes\.apple\.com\/uts\/(v1|v2|v3)\/
      name: TV.response
      type: response
      require-body: true
    - match: ^https?:\/\/umc-tempo-api\.apple\.com\/(v1|v2|v3)\/
      name: TV.request
      type: request
      require-body: true

script-providers:
  TV.request:
    url: https://github.com/NSRingo/TV/releases/download/v{{@package 'version'}}/request.bundle.js
    interval: 86400
  TV.response:
    url: https://github.com/NSRingo/TV/releases/download/v{{@package 'version'}}/response.bundle.js
    interval: 86400
