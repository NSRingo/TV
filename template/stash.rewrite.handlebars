name: "{{@package 'displayName'}} (Rewrite)"
desc: |-
  {{#each (split (@package 'description') "\n")}}
  {{{this}}}
  {{/each}}
author: |-
  {{#each (@package 'contributors')}}
  {{{this}}}
  {{/each}}
homepage: "{{@package 'homepage'}}"
icon: "{{@package 'icon'}}"
category: "{{@package 'organizationName'}}"
date: "{{now "yyyy-MM-dd HH:mm:ss"}}"

rules:
  - DOMAIN,known-issues.apple.com,REJECT-DROP

http:
  mitm:
    - "uts-api.itunes.apple.com"
    - "umc-tempo-api.apple.com"
    - "play-cdn.itunes.apple.com"
    - "play-edge-cdn.itunes.apple.com"
  url-rewrite:
    - ^https?:\/\/play-cdn\.itunes\.apple\.com https://play.itunes.apple.com header
    - ^https?:\/\/play-edge-cdn\.itunes\.apple\.com https://play-edge.itunes.apple.com header
    - ^https?:\/\/uts-api\.itunes\.apple\.com\/(uts\/(?:v1|v2|v3)\/.*) https://tvkit.pages.dev/$1 transparent
    - ^https?:\/\/umc-tempo-api\.apple\.com\/((?:v1|v2|v3)\/.*) https://tvkit.pages.dev/$1 transparent
