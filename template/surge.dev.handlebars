[Rule]
DOMAIN,known-issues.apple.com,REJECT-DROP

[URL Rewrite]
^https?:\/\/play-cdn\.itunes\.apple\.com https://play.itunes.apple.com header
^https?:\/\/play-edge-cdn\.itunes\.apple\.com https://play-edge.itunes.apple.com header

[Script]
📺 TV.lumen.response = type=http-response, pattern=^https?:\/\/www\.lumen\.ax\/api\/appletv\/v1\/uts\/v3\/shows\/[^\/?]+(?:\/episodes)?(?:\?.*)?$, requires-body=1, script-path=https://gist.githubusercontent.com/VirgilClyne/fa7b08c6994b555b82b6d22df89f8a31/raw/response.lumen.dev.bundle.js, argument={{{scriptParams}}}
📺 TV.uts.request = type=http-request, pattern=^https?:\/\/uts-api\.itunes\.apple\.com\/uts\/(v1|v2|v3)\/, requires-body=1, script-path=https://gist.githubusercontent.com/VirgilClyne/fa7b08c6994b555b82b6d22df89f8a31/raw/request.dev.bundle.js, argument={{{scriptParams}}}
